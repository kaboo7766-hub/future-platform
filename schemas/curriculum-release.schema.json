{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://future-platform.example/schemas/curriculum-release.schema.json",
  "title": "Future Platform curriculum release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "country",
    "systemId",
    "schoolYear",
    "term",
    "gradeId",
    "subjectId",
    "subjectName",
    "source",
    "status",
    "units"
  ],
  "properties": {
    "country": {
      "type": "string",
      "minLength": 2
    },
    "systemId": {
      "type": "string",
      "minLength": 2
    },
    "schoolYear": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{4}$"
    },
    "term": {
      "enum": [
        "annual",
        "term1",
        "term2"
      ]
    },
    "gradeId": {
      "type": "string",
      "minLength": 2
    },
    "subjectId": {
      "type": "string",
      "minLength": 2
    },
    "subjectName": {
      "type": "string",
      "minLength": 2
    },
    "language": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "url",
        "edition"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "edition": {
          "type": "string",
          "minLength": 2
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        },
        "fileHash": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "published",
        "archived"
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "reviewerId": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "unitId",
          "title",
          "order",
          "lessons",
          "unitExam"
        ],
        "properties": {
          "unitId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "lessonId",
                "title",
                "order",
                "objectives",
                "explanation",
                "activities",
                "practice"
              ],
              "properties": {
                "lessonId": {
                  "type": "string"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "objectives": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1
                },
                "activities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "practice": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/question"
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "unitExam": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/question"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "subjectExam": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": [
        "questionId",
        "type",
        "prompt",
        "points"
      ],
      "properties": {
        "questionId": {
          "type": "string"
        },
        "type": {
          "enum": [
            "multiple_choice",
            "true_false",
            "complete",
            "match",
            "order",
            "short_answer",
            "essay"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer": {
          "type": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ]
        },
        "explanation": {
          "type": "string"
        },
        "points": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    }
  }
}
