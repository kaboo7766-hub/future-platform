rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && me().role == 'admin'; }
    function isStaff() { return signedIn() && me().role in ['admin','teacher']; }
    function teacherHasClass(classId) {
      return signedIn() && me().role == 'teacher'
        && classId is string && ('classIds' in me())
        && me().classIds is list && classId in me().classIds;
    }
    function canManageClass(classId) { return isAdmin() || teacherHasClass(classId); }
    function canManageQuiz(quizId) {
      let quiz = get(/databases/$(db)/documents/quizzes/$(quizId)).data;
      let lesson = get(/databases/$(db)/documents/lessons/$(quiz.lessonId)).data;
      return isAdmin() || teacherHasClass(lesson.classId);
    }
    function linked(owner) { return signedIn() && exists(/databases/$(db)/documents/parentLinks/$(request.auth.uid + '_' + owner)); }

    match /parentLinks/{id} {
      allow read: if signedIn() && (resource.data.parentUid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || linked(uid) || teacherHasClass(resource.data.classId));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['student','parent','pending']
        && request.resource.data.keys().hasOnly(['uid','name','email','role','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() < 80;
      allow delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classId','onboarded']));
    }
    match /classes/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /settings/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /lessons/{id} {
      allow read: if signedIn() && (
        isAdmin() || teacherHasClass(resource.data.classId)
        || (resource.data.published == true
          && (me().role != 'student' || resource.data.classId == me().classId))
      );
      allow create, update: if canManageClass(request.resource.data.classId)
        && request.resource.data.title is string
        && request.resource.data.title.size() < 150
        && ((('url' in request.resource.data) && request.resource.data.url is string && request.resource.data.url.matches('https://.*'))
          || (request.resource.data.type == 'image' && ('imageData' in request.resource.data)
            && request.resource.data.imageData is string
            && request.resource.data.imageData.size() < 650000
            && request.resource.data.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')));
      allow delete: if isAdmin();
    }
    match /attendance/{id} {
      function validAttendance() {
        let lesson = get(/databases/$(db)/documents/lessons/$(request.resource.data.lessonId)).data;
        return signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == me().role
          && request.resource.data.role in ['student','teacher','admin']
          && request.resource.data.userName is string
          && request.resource.data.userName.size() <= 100
          && request.resource.data.lessonId is string
          && request.resource.data.lessonTitle is string
          && request.resource.data.lessonTitle.size() <= 150
          && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && id == request.auth.uid + '_' + request.resource.data.lessonId + '_' + request.resource.data.dateKey
          && request.resource.data.keys().hasOnly(['uid','userName','role','lessonId','lessonTitle','classId','subjectId','dateKey','enteredAt'])
          && request.resource.data.classId == lesson.classId
          && (lesson.published == true || canManageClass(lesson.classId));
      }
      allow read: if signedIn() && (isAdmin()
        || (resource.data.uid == request.auth.uid)
        || linked(resource.data.uid)
        || teacherHasClass(resource.data.classId));
      allow create: if validAttendance();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /quizzes/{id} {
      function lessonClass() {
        return get(/databases/$(db)/documents/lessons/$(resource.data.lessonId)).data.classId;
      }
      allow read: if signedIn() && (isAdmin() || teacherHasClass(resource.data.classId)
        || (resource.data.published == true
          && me().role == 'student'
          && resource.data.classId == me().classId));
      allow create, update: if canManageClass(
        get(/databases/$(db)/documents/lessons/$(request.resource.data.lessonId)).data.classId
      ) && request.resource.data.classId ==
        get(/databases/$(db)/documents/lessons/$(request.resource.data.lessonId)).data.classId
        && request.resource.data.questions.size() > 0 && request.resource.data.questions.size() <= 50;
      allow delete: if isAdmin();
    }
    match /quizResults/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin() || linked(resource.data.uid)
        || canManageQuiz(resource.data.quizId));
      allow create, update, delete: if false;
    }
    match /quizAnswerKeys/{quizId} {
      allow read: if canManageQuiz(quizId);
      allow create, update: if isAdmin()
        || teacherHasClass(getAfter(/databases/$(db)/documents/quizzes/$(quizId)).data.classId);
      allow delete: if isAdmin();
    }
    match /progress/{id} {
      function validStudentProgress() {
        let lesson = get(/databases/$(db)/documents/lessons/$(request.resource.data.lessonId)).data;
        let student = get(/databases/$(db)/documents/users/$(request.auth.uid)).data;
        return signedIn() && student.role == 'student' && request.resource.data.uid == request.auth.uid
          && request.resource.data.lessonId is string
          && id == request.auth.uid + '_' + request.resource.data.lessonId
          && request.resource.data.keys().hasOnly(['uid','lessonId','subjectId','classId','completed','openedAtMs','updatedAt'])
          && lesson.published == true && lesson.classId == student.classId
          && request.resource.data.classId == lesson.classId
          && request.resource.data.subjectId == lesson.subjectId
          && (!('completed' in request.resource.data) || request.resource.data.completed is bool)
          && (!('openedAtMs' in request.resource.data) || request.resource.data.openedAtMs is number);
      }
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin() || linked(resource.data.uid) || teacherHasClass(resource.data.classId));
      allow create, update: if validStudentProgress();
      allow delete: if false;
    }
    match /assignments/{id} {
      allow read: if signedIn() && (isAdmin()
        || teacherHasClass(resource.data.classId)
        || (me().role == 'teacher' && resource.data.createdBy == request.auth.uid)
        || (me().role == 'student' && (!('classId' in resource.data) || resource.data.classId == me().classId)));
      allow create, update: if canManageClass(request.resource.data.classId)
        && request.resource.data.title is string && request.resource.data.title.size() < 150;
      allow delete: if isAdmin();
    }
    match /submissions/{id} {
      function assignmentClass() {
        return get(/databases/$(db)/documents/assignments/$(resource.data.assignmentId)).data.classId;
      }
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()
        || linked(resource.data.uid) || teacherHasClass(resource.data.classId));
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && get(/databases/$(db)/documents/assignments/$(request.resource.data.assignmentId)).data.classId == me().classId
        && request.resource.data.classId == me().classId
        && id == request.resource.data.assignmentId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['assignmentId','uid','studentName','classId','text','link','submittedAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && (!('link' in request.resource.data) || request.resource.data.link == '' || request.resource.data.link.matches('https://.*'));
      allow update: if (signedIn() && resource.data.uid == request.auth.uid && !('grade' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','link','submittedAt']))
        || ((isAdmin() || teacherHasClass(assignmentClass()))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grade','feedback','gradedAt'])
          && request.resource.data.grade is number && request.resource.data.grade >= 0 && request.resource.data.grade <= 100);
      allow delete: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if signedIn() && (resource.data.audience == 'all' || resource.data.audience == request.auth.uid);
      allow create: if isStaff() && request.resource.data.keys().hasOnly(['audience','title','body','at','createdBy']);
      allow update, delete: if false;
    }
    match /points/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || linked(uid) || teacherHasClass(get(/databases/$(db)/documents/users/$(uid)).data.classId));
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['uid','total','updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.total is int
        && request.resource.data.total >= 0 && request.resource.data.total <= 50;
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['uid','total','updatedAt'])
        && request.resource.data.total is int && request.resource.data.total >= resource.data.total
        && request.resource.data.total - resource.data.total <= 50;
      allow delete: if isAdmin();
    }
    match /certificates/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin() || linked(resource.data.uid) || teacherHasClass(get(/databases/$(db)/documents/users/$(resource.data.uid)).data.classId));
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.subjectId
        && request.resource.data.keys().hasOnly(['uid','studentName','subjectId','subjectName','number','issuedAt'])
        && request.resource.data.number.matches('FM-[0-9A-F]{12}');
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /siteTeachers/{id} { allow read: if true; allow write: if isAdmin(); }
    match /siteTestimonials/{id} { allow read: if true; allow write: if isAdmin(); }
    match /siteSettings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /activityLogs/{id} {
      function validLogShape() {
        return request.resource.data.keys().hasOnly(['uid','action','target','at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.action is string && request.resource.data.action.size() <= 40
          && request.resource.data.target is string && request.resource.data.target.size() <= 150
          && request.resource.data.at == request.time;
      }
      allow create: if signedIn() && validLogShape()
        && ((request.resource.data.action == 'lesson.create' && isStaff())
          || (request.resource.data.action in ['teacher.approve','user.role','parent.link','parent.unlink'] && isAdmin()));
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}